APP_NAME="AvtoGlass KZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Almaty

APP_LOCALE=ru
# Русские переводы пакетов местами отстают от английских. Фоллбэк на ru
# означает, что непереведённый ключ печатается как есть — пользователь
# видит filament::components/loading-section.label вместо текста.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL, а не SQLite: сессии, кеш и очередь тоже живут в базе,
# и один файл на диске их одновременной записи не выдержит.
# Тесты гоняются на отдельной базе того же движка — расхождения диалектов
# должны падать на прогоне, а не на бою.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5440
DB_DATABASE=avtoglasskz
DB_USERNAME=postgres
DB_PASSWORD=
# Базу под тесты (avtoglasskz_test) нужно создать заранее — её имя задано
# в phpunit.xml, а не здесь, иначе прогон пойдёт по рабочим данным.

SESSION_DRIVER=database
SESSION_LIFETIME=120
# На бою: шифрование содержимого и только HTTPS-куки.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Очередь нужна для оповещений о заявке и фискальных чеков.
# Без воркера заявки создаются, но менеджер не получит сообщение,
# а чек ОФД останется в статусе «ожидает».
# Windows (отдельное окно): php artisan queue:work --tries=3
# Linux (supervisor или systemd): тот же queue:work постоянно.
#
# Расписание (снятие просроченных резервов раз в час, карта сайта раз в сутки):
# Windows: php artisan schedule:work
# Linux cron: * * * * * cd /path && php artisan schedule:run >> /dev/null 2>&1
#
# 2FA сотрудников: в админке Профиль → приложение-аутентификатор.
# Пока не включили — вход только паролем. Обязательным не делаем.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log — пишет письмо в storage/logs, smtp — в настоящий ящик.
# Без SMTP заявка создаётся, но смена письмо не увидит.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="order@avto-glass.kz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Уведомления смене о новой заявке
#
# Клиент в этой нише оставляет заявку сразу в нескольких местах, и продаёт
# тот, кто перезвонил первым. Пока сюда не вписан бот, заявку видно только
# в админке — то есть срок звонка в 15 минут не работает.
#
# Бот заводится у @BotFather; chat_id группового чата начинается с минуса.
# ---------------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp смены (Green-API). Без этих ключей клиент всё равно может
# отправить заявку кнопкой на странице «спасибо».
WHATSAPP_GREEN_INSTANCE=
WHATSAPP_GREEN_TOKEN=
WHATSAPP_ALERT_CHAT=

# Письмо смене о заявке. Пусто — на почту компании из настроек.
# Несколько адресов через запятую.
ORDER_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Приём оплаты
#
# Карта с витрины всегда идёт в Halyk. Пустые HALYK_* — публичная песочница
# банка: форма карты открывается, деньги не списываются.
# PAYMENT_DRIVER=test оставляет заглушку для тестов и кнопки «оплатить»
# у старых заявок без выбранного способа.
# ---------------------------------------------------------------------------
PAYMENT_DRIVER=test
PAYMENT_SECRET=local-test-secret

HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_TERMINAL=
HALYK_TEST_MODE=true

FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
FREEDOMPAY_TEST_MODE=true

KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_TEST_MODE=true
KASPI_API_URL=

# ---------------------------------------------------------------------------
# Фискализация (ОФД)
#
# Отдельно от приёма денег: эквайер получает оплату, Webkassa выбивает чек.
# Одно без другого в Казахстане незаконно, но падать друг из-за друга они
# не должны — чек выбивается очередью и не блокирует оплату.
# ---------------------------------------------------------------------------
FISCAL_ENABLED=false
WEBKASSA_TEST_MODE=true
WEBKASSA_LOGIN=
WEBKASSA_PASSWORD=
WEBKASSA_CASHBOX=

# ---------------------------------------------------------------------------
# Реквизиты для документов
#
# Запасные значения, если в админке (Настройки → Реквизиты) ещё ничего
# не сохраняли. После сохранения в CRM источником правды становится база.
# Пока БИН пуст, счёт печатается с пометкой, что юридической силы не имеет.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_BIN=
COMPANY_IIK=
COMPANY_BANK=
COMPANY_BIK=
COMPANY_DIRECTOR=
COMPANY_VAT_PAYER=false
COMPANY_WHATSAPP=77003375208

# Сколько дней держать стекло за неоплаченным заказом
RESERVATION_UNPAID_DAYS=3

# ---------------------------------------------------------------------------
# AI-помощник (бесплатный Gemini / локальный LiteLLM)
#
# Чат на витрине: помогает подобрать стекло и оформить заявку диалогом.
# Включается в CRM (Настройки → AI-помощник), ключи живут только здесь.
#
# Ключ: aistudio.google.com → Get API key. Ключи одного проекта имеют общую квоту.
# Платные cloud-маршруты в приложении и в LiteLLM должны быть отключены.
#
# Использовать проект Gemini без billing: название модели не запрещает списания.
# Бесплатный text tier проверять: https://ai.google.dev/gemini-api/docs/pricing
# CRM может выбрать только модели из разрешённого списка приложения и GEMINI_MODELS.
# Ошибки и fallback ограничены общим deadline и числом попыток.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_SECOND=
GEMINI_MODELS=gemini-3.1-flash-lite
GEMINI_COOLDOWN_MINUTES=60
AI_PROVIDER_MODE=gemini_only
# local_only / gemini_only / local_then_gemini. Local-first включать после проверки модели.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=qwen-chat
AI_SYNC_BUDGET_SECONDS=20
AI_JOB_BUDGET_SECONDS=30
AI_REQUEST_TIMEOUT=8
LITELLM_REQUEST_TIMEOUT=15
AI_MAX_ATTEMPTS=2
AI_MAX_CONCURRENT=10
AI_PROVIDER_RPM=10
AI_GUEST_HISTORY_DAYS=30
AI_ACCOUNT_HISTORY_DAYS=180
AI_IMPORT_FILE_DAYS=7
# Отдельная асинхронная очередь: php artisan queue:work database --queue=ai --timeout=60 --tries=1
AI_QUEUE_CONNECTION=database
AI_QUEUE_NAME=ai

# API общего ядра заказа. Включать после миграций и проверок нового потока.
ORDERING_API_ENABLED=false
# Витрина оформляет заказы через новое ядро (DraftService/SubmitDraft).
ORDERING_STOREFRONT_CORE=false
ORDERING_AUTO_CHECKOUT_ENABLED=false
ORDERING_WHOLESALE_AUTO_CHECKOUT_ENABLED=false
ORDERING_ONLINE_RESERVATION_MINUTES=15
ORDERING_QUOTE_TTL_MINUTES=15
# Только драйверы, проверенные на конкретном merchant sandbox; пусто = без онлайн-оплаты нового потока.
PAYMENTS_VERIFIED_DRIVERS=

# Безопасность: боевой CSP (по умолчанию Report-Only), обязательная 2FA
# персонала, срок хранения ПДн в месяцах.
CSP_ENFORCE=false
STAFF_2FA_REQUIRED=false
PDN_RETENTION_MONTHS=36
