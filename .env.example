APP_NAME="AvtoGlass KZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Almaty

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL, а не SQLite: сессии, кеш и очередь тоже живут в базе,
# и один файл на диске их одновременной записи не выдержит.
# Тесты гоняются на отдельной базе того же движка — расхождения диалектов
# должны падать на прогоне, а не на бою.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=avtoglasskz
DB_USERNAME=postgres
DB_PASSWORD=
# Базу под тесты (avtoglasskz_test) нужно создать заранее — её имя задано
# в phpunit.xml, а не здесь, иначе прогон пойдёт по рабочим данным.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Уведомления смене о новой заявке
#
# Клиент в этой нише оставляет заявку сразу в нескольких местах, и продаёт
# тот, кто перезвонил первым. Пока сюда не вписан бот, заявку видно только
# в админке — то есть срок звонка в 15 минут не работает.
#
# Бот заводится у @BotFather; chat_id группового чата начинается с минуса.
# ---------------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Приём оплаты
#
# Без ключей работает тестовый шлюз: оплата подтверждается по подписанной
# ссылке, настоящих денег не двигает. На бой нужен хотя бы один настоящий.
# ---------------------------------------------------------------------------
PAYMENT_DRIVER=test
PAYMENT_SECRET=local-test-secret

HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_TERMINAL=
HALYK_TEST_MODE=true

FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
FREEDOMPAY_TEST_MODE=true

# ---------------------------------------------------------------------------
# Фискализация (ОФД)
#
# Отдельно от приёма денег: эквайер получает оплату, Webkassa выбивает чек.
# Одно без другого в Казахстане незаконно, но падать друг из-за друга они
# не должны — чек выбивается очередью и не блокирует оплату.
# ---------------------------------------------------------------------------
FISCAL_ENABLED=false
WEBKASSA_TEST_MODE=true
WEBKASSA_LOGIN=
WEBKASSA_PASSWORD=
WEBKASSA_CASHBOX=

# ---------------------------------------------------------------------------
# Реквизиты для документов
#
# Пока БИН и ИИК пусты, счёт на оплату печатается с пометкой, что
# юридической силы не имеет. Это намеренно: пустой счёт не должен уехать
# клиенту незамеченным.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_BIN=
COMPANY_IIK=
COMPANY_BANK=
COMPANY_BIK=
COMPANY_DIRECTOR=
COMPANY_VAT_PAYER=false
COMPANY_WHATSAPP=77003375208

# Сколько дней держать стекло за неоплаченным заказом
RESERVATION_UNPAID_DAYS=3
