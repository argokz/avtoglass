# Рабочие данные, а не код: боевая база живёт в PostgreSQL,
# а этот файл остался снимком до переезда.
/database/*.sqlite

# Загруженные фотографии товаров и логотипы марок
/storage/app/public/products
/storage/app/public/brands

# Временные файлы: сюда переехал системный TEMP, чтобы не забивать диск C:
/storage/tmp

# Ассеты Filament — их пересобирает `php artisan filament:assets`
# на каждом composer install, держать их копию в истории незачем.
/public/css/filament
/public/js/filament
/public/fonts/filament

# Старый лендинг avto-glass.kz: держим на диске как справку по контактам
# и текстам, но в историю проекта не тащим — это 11 МБ чужой статики,
# которую из git потом уже не убрать.
/old-lp

# Локальный nginx разработчика: в нём конфигурация других проектов на этой
# машине. Боевой конфиг сайта лежит в deploy/nginx/.
/nginx.conf
/nginx.conf.backup

# Генерируется командой sitemap:generate по расписанию.
/public/sitemap.xml
